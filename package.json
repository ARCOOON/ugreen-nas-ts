{
  "name": "@ugreen-nas/sdk",
  "version": "1.1.0",
  "type": "module",
  "description": "Object-Oriented Management SDK for UGREEN NAS devices running UGOS Pro / UGOS",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc",
    "pack": "npm run build && npm pack",
    "test": "node --experimental-strip-types src/index.ts"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.8.0"
  },
  "keywords": [
    "ugreen",
    "nas",
    "ugos",
    "ugos-pro",
    "sdk",
    "dxp",
    "dxp2800",
    "dxp4800"
  ],
  "author": "UGREEN NAS Community",
  "license": "MIT"
}
